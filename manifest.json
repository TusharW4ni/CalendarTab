{
  "manifest_version": 2,
  "name": "CalendarTab",
  "author": "Tushar Wani",
  "version": "1.0",
  "description": "Simple calendar on new tab.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "calendar.html"
  },
  "icons": {
    "16": "./calendartab-icon.svg",
    "48": "./calendartab-icon.svg",
    "96": "./calendartab-icon.svg"
  }
}
